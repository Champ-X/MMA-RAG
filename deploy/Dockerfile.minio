# syntax=docker/dockerfile:1
# Upstream stopped distributing community images/binaries. Keep the existing
# storage version and verify the exact official source archive instead of downgrading.
FROM golang:1.24.7-bookworm AS build
WORKDIR /src
RUN curl --fail --location --retry 3 \
      https://codeload.github.com/minio/minio/tar.gz/07c3a429bfed433e49018cb0f78a52145d4bedeb \
      -o /source.tar.gz \
    && echo '8819e3e7817e46b7b3798f8f200ead208562e571563c2e040352378031abe9f2  /source.tar.gz' | sha256sum --check \
    && tar -xzf /source.tar.gz --strip-components=1
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=1GiB
RUN --mount=type=cache,target=/go/pkg/mod go mod download -x
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -v -p 2 -trimpath \
      -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2025-09-07T16:13:09Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-09-07T16-13-09Z -X github.com/minio/minio/cmd.CommitID=07c3a429bfed433e49018cb0f78a52145d4bedeb -X github.com/minio/minio/cmd.ShortCommitID=07c3a429bfed4 -X github.com/minio/minio/cmd.CopyrightYear=2025' \
      -o /out/minio .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /src/LICENSE /src/CREDITS /usr/share/licenses/minio/
COPY --from=build /source.tar.gz /usr/share/minio/source.tar.gz
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
      org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
