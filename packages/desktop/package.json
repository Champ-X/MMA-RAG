{
  "name": "@tessmora/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tessmora desktop workspace",
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:electron": "node qa/electron-smoke.mjs",
