      "customData": {
        "sourceShapeId": "shape:mma-pi-note-media",
        "section": 4
      },
      "text": "Original data\nQdrant: indexed text & source positions.\nMinIO: KB originals & derived media.\nLocal Pi directory: attachments & previews.\nExact media caching is limited to one run.",
      "originalText": "Original data\nQdrant: indexed text & source positions.\nMinIO: KB originals & derived media.\nLocal Pi directory: attachments & previews.\nExact media caching is limited to one run.",
