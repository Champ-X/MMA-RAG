    {
      "id": "mma-mma-overview-notes-text",
      "type": "text",
      "x": 104,
      "y": 2374.25,
      "width": 1392,
      "height": 121.50000000000001,
      "angle": 0,
      "strokeColor": "#1d1d1d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "mma-section-1"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 137915391,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793894400000,
      "link": null,
      "locked": false,
      "customData": {
        "sourceShapeId": "shape:mma-overview-notes",
        "section": 1
      },
      "text": "Data flow: ingestion writes MinIO / Qdrant; standard retrieval reads Qdrant; Pi reads indexes and originals, and records evidence in its own ledger.\nShared capabilities: LLMManager / model routing; BGE-M3, CLIP, CLAP; FFmpeg and LibreOffice.\nDecision: optional requirement checks and citation diagnostics for the standard path; off by default.\nLegend: blue = interaction / standard path; orange = ingestion; purple = Pi; green = persistent data. Dashed links indicate optional or supporting\nrelationships.",
      "originalText": "Data flow: ingestion writes MinIO / Qdrant; standard retrieval reads Qdrant; Pi reads indexes and originals, and records evidence in its own ledger.\nShared capabilities: LLMManager / model routing; BGE-M3, CLIP, CLAP; FFmpeg and LibreOffice.\nDecision: optional requirement checks and citation diagnostics for the standard path; off by default.\nLegend: blue = interaction / standard path; orange = ingestion; purple = Pi; green = persistent data. Dashed links indicate optional or supporting relationships.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "mma-mma-overview-notes",
      "autoResize": false,
      "lineHeight": 1.35
    },
