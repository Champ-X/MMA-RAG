    {
      "id": "mma-mma-retrieval-note-agent-text",
      "type": "text",
      "x": 4844,
      "y": 1808.5,
      "width": 392,
      "height": 243.00000000000003,
      "angle": 0,
      "strokeColor": "#1d1d1d",
