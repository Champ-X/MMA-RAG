    {
      "id": "mma-mma-retrieval-note-rank-text",
      "type": "text",
      "x": 3804,
      "y": 1808.5,
      "width": 392,
      "height": 243.00000000000003,
      "angle": 0,
      "strokeColor": "#1d1d1d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
