    {
      "id": "mma-mma-pi-note-exit-text",
      "type": "text",
      "x": 6694,
      "y": 2885.65,
      "width": 392,
      "height": 218.70000000000002,
      "angle": 0,
      "strokeColor": "#1d1d1d",
      "backgroundColor": "transparent",
