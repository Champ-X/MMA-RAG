    {
      "id": "mma-mma-retrieval-subtitle-text",
      "type": "text",
      "x": 3780,
      "y": 366,
      "width": 1520,
      "height": 64.80000000000001,
      "angle": 0,
      "strokeColor": "#8795a7",
