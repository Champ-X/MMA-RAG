      "customData": {
        "sourceShapeId": "shape:mma-retrieval-note-scope",
        "section": 3
      },
      "text": "Scope & reference materials\n\nKB / file selectors limit search scope.\n@ materials add reading context, not\naccess rights.\nModality exclusions apply to retrieval, file\nbindings and Agent subqueries.\nAutomatic source expansion respects\nexplicit scope.",
      "originalText": "Scope & reference materials\n\nKB / file selectors limit search scope.\n@ materials add reading context, not access rights.\nModality exclusions apply to retrieval, file bindings and Agent subqueries.\nAutomatic source expansion respects explicit scope.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "mma-mma-retrieval-note-scope",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
