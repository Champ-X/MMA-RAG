      "link": null,
      "locked": false,
      "customData": {
        "sourceShapeId": "shape:mma-pi-note-exit",
        "section": 4
      },
      "text": "Termination & recovery\n\nDelivered: completed / partial.\nClarification: needs_input.\nUser stop: cancelling > cancelled.\nErrors: failed; retain evidence and receipts.\nHost restart: unfinished runs become failed\n/ cancelled with code=host_restarted; no\nautomatic paid-request replay.",
      "originalText": "Termination & recovery\n\nDelivered: completed / partial.\nClarification: needs_input.\nUser stop: cancelling > cancelled.\nErrors: failed; retain evidence and receipts.\nHost restart: unfinished runs become failed / cancelled with code=host_restarted; no automatic paid-request replay.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "mma-mma-pi-note-exit",
      "autoResize": false,
      "lineHeight": 1.35
    },
