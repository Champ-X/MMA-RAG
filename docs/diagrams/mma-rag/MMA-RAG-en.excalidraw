      "customData": {
        "sourceShapeId": "shape:mma-retrieval-note-frontend",
        "section": 3
      },
      "text": "Frontend: services/sse_stream.ts handles chunks and text buffering. Citations link back to text, images and audio-video ranges.\nthought denotes structured execution stages. Diagnostic coverage and citation identity do not certify the whole answer.\nStandard Chat sessions are mainly in memory, with browser snapshots. Pi uses an independent durable event ledger.",
      "originalText": "Frontend: services/sse_stream.ts handles chunks and text buffering. Citations link back to text, images and audio-video ranges.\nthought denotes structured execution stages. Diagnostic coverage and citation identity do not certify the whole answer.\nStandard Chat sessions are mainly in memory, with browser snapshots. Pi uses an independent durable event ledger.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "mma-mma-retrieval-note-frontend",
      "autoResize": false,
      "lineHeight": 1.35
    },
