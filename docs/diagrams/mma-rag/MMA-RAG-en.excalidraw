      "link": null,
      "locked": false,
      "customData": {
        "sourceShapeId": "shape:mma-retrieval-subtitle",
        "section": 3
      },
      "text": "Direct and the bounded Agent share an evidence chain; Decision is optional\nmain · 658b0d1 · 2026-11-05",
      "originalText": "Direct and the bounded Agent share an evidence chain; Decision is optional\nmain · 658b0d1 · 2026-11-05",
      "fontSize": 24,
