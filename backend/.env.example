# Compose-local credentials. Change them before exposing this stack beyond loopback.
POSTGRES_PASSWORD=nexus-local
MINIO_ROOT_USER=nexus
MINIO_ROOT_PASSWORD=nexus-local-secret

# Official MinerU Precision API. PDF/DOC/DOCX/PPT/PPTX fail explicitly without it.
# Create a token at https://mineru.net/apiManage/token and never commit this file.
MINERU_TOKEN=
NEXUS_MINERU_BASE_URL=https://mineru.net/api/v4
NEXUS_MINERU_MODEL=vlm
NEXUS_MINERU_LANGUAGE=ch
NEXUS_MINERU_TIMEOUT_SECONDS=900

# Optional OpenAI-compatible generation route. The local extractive gateway is used when absent.
NEXUS_GENERATION_ENDPOINT=
NEXUS_GENERATION_API_KEY=
NEXUS_GENERATION_MODEL=

# Optional PaddleOCR-VL endpoint for visible text/layout in standalone images.
PADDLEOCR_API_URL=
PADDLEOCR_TOKEN=

# Capability and safety switches.
NEXUS_RESEARCH_RUNTIME_ENABLED=true
NEXUS_EXTERNAL_TOOLS_ENABLED=false
NEXUS_BACKGROUND_ENRICHMENT_ENABLED=true
NEXUS_KNOWLEDGE_COMPILATION_ENABLED=false
NEXUS_PAGE_MULTIVECTOR_ENABLED=false
NEXUS_SPARSE_ENCODER=deterministic
NEXUS_BGE_M3_MODEL_ID=BAAI/bge-m3
NEXUS_BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
NEXUS_BGE_M3_USE_FP16=false
NEXUS_HF_ENDPOINT=
NEXUS_CLIP_MODEL_ID=openai/clip-vit-large-patch14
NEXUS_CLIP_MODEL_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
NEXUS_CLAP_MODEL_ID=laion/clap-htsat-fused
NEXUS_CLAP_MODEL_REVISION=365dea6ef167def6676140ed93bbc43f84dabb28

# Runtime limits.
NEXUS_PROVIDER_TIMEOUT_SECONDS=180
NEXUS_MAX_UPLOAD_BYTES=1073741824
NEXUS_CONNECTOR_ALLOWED_FOLDER_ROOTS=/imports
NEXUS_CONNECTOR_MAX_DOWNLOAD_BYTES=268435456
NEXUS_CONNECTOR_TIMEOUT_SECONDS=30
NEXUS_CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
# Optional connected acquisition providers. Internet Archive image search is keyless.
TAVILY_API_KEY=
SERPAPI_KEY=
PIXABAY_API_KEY=
NEXUS_CELERY_BROKER_URL=redis://redis:6379/0
NEXUS_CELERY_RESULT_BACKEND=redis://redis:6379/1
NEXUS_SCHEDULER_INTERVAL_SECONDS=2

# Local OpenTelemetry. Leave the endpoint empty for in-process trace IDs only.
NEXUS_OTEL_ENABLED=true
NEXUS_OTEL_SERVICE_NAME=mma-rag-nexus
NEXUS_OTEL_EXPORTER_OTLP_ENDPOINT=
NEXUS_CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
# Optional Feishu/Lark IM long-connection channel. Run with the Compose `feishu`
# profile. The channel creates normal Nexus Runs and uses explicit Space scope.
FEISHU_WS_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_DEFAULT_SPACE_IDS=
FEISHU_REPLY_IN_THREAD=false
# `card` keeps rich IM presentation without reintroducing the legacy Feishu
# session/knowledge authority; use `text` for the smallest permission surface.
NEXUS_FEISHU_REPLY_FORMAT=card
NEXUS_FEISHU_RUN_TIMEOUT_SECONDS=180
